# SCDE sample configuration - copy to ~/.config/scde/config
# format: key=value   (lines starting with # are comments)

# ---------------------------------------------------------------- shell
# SCDE Harbor: a slim menu bar is always pinned to the top edge and a
# floating dock sits centred above the bottom edge.  The legacy
# panel=bottom/top key is accepted but ignored.
panel_height=28

# window frame border and title bar
border_width=1
title_height=28

# 1 = focus follows mouse, 0 = click to focus
focus_follows_mouse=1

# ---------------------------------------------------------------- desktop
# macOS-inspired dark theme: graphite surfaces, soft white text and
# system blue as the single accent.
background=#0b0c10
wallpaper_top=#222b46
wallpaper_bottom=#08090e

border_focused=#3c3d46
border_unfocused=#2a2b31

title_bg=#303138
title_bg_inactive=#26272d
title_fg=#f5f5f7
title_fg_inactive=#9a9aa2
title_hover=#3a3b43
title_close_hover=#e0443e

# installed applications shown as icons on the desktop
desktop_apps=0

# ---------------------------------------------------------------- menu bar
show_clock=1
# macOS-style date + time at the right end of the menu bar
clock_format=%a %d %b  %H:%M
# optional second clock line (leave empty for a single macOS-style line)
clock_date_format=
show_tray=1

panel_bg=#24252c
panel_fg=#f5f5f7
button_active=#3a3b43
button_inactive=#2b2c32
button_hover=#34353c

# application menu colours
menu_bg=#24252c
menu_fg=#f2f2f7
menu_selected=#0a84ff

# ------------------------------------------------- sandbox resource limits
# RAM ceiling per sandboxed process (MiB).  3072 MiB = 3 GiB.
# Enforced by the kernel (RLIMIT_AS in the child before exec); an
# existing stricter hard limit is kept and never raised.  SCDE imposes
# no CPU quota of its own - the host scheduler decides.
sandbox_memory_mb=3072

# ---------------------------------------------------------------- programs
# terminal started with Alt+Enter and by the Terminal menu entry
# (leave empty to auto-detect xterm/urxvt/gnome-terminal/...)
terminal=xterm
# browser used by the Web Browser menu entry and for URLs typed into Alt+F2
# (empty = first of firefox, chromium, ... found in PATH)
browser=

# image shown on the desktop (feh loads it)
wallpaper=

# font used by the shell (X core font; empty = auto-detected sans font)
font=

# application menu entries: menu=Label|command
# pinned above the .desktop applications scanned from /usr/share/applications
menu=Terminal|xterm
menu=Editor|${EDITOR:-vi}
menu=Files|@files
